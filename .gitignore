# The datasets. Gigabytes, redistributed under their own licences, and
# reproducible from scripts/fetch_kitti.py. The 20-frame fixture under
# tests/fixtures/ is committed deliberately and is NOT covered by this.
data/

# Model weights and exports. Reproducible from the export script, and a
# committed .onnx would be a binary blob nobody can review.
models/
*.onnx
*.pt

# Generated outputs. The REPORT is committed on purpose: the milestone is "one
# command produces the HTML", and an artifact nobody can open without running
# the pipeline first is not a deliverable. The detection cache is not: it is
# megabytes of intermediate that regenerates from the model and the split.
outputs/*
!outputs/report.html
!outputs/results.json
!outputs/traceability.md
!outputs/sim_to_real.json
!outputs/p3-demo.mp4
!outputs/examples/
outputs/examples/*
!outputs/examples/*.png

__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/
